{
  "name": "mugua-api-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:verify": "npm run docs:check && npm run docs:build && node scripts/check-docs.mjs --built"
  },
  "devDependencies": {
    "smol-toml": "^1.9.1",
    "vitepress": "2.0.0-alpha.17"
  }
}
